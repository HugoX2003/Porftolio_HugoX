---
import { Image } from "astro:assets";
import profileImg from "../assets/profile.webp";
---

<section id="about" class="about-section">
    <div class="container about-content">
        <div class="about-text">
            <p class="section-path">who i am</p>
            <h2 class="section-title">About me</h2>
            <p>
                I am a <span class="highlight"
                    >Computer and Systems Engineering</span
                > student (10th cycle) at UPAO in Trujillo, Peru, working as a
                <span class="highlight">Backend Developer</span> and
                <span class="highlight">DevOps Engineer</span>, with fullstack
                experience and a strong eye for design and user experience.
            </p>
            <p class="freelance-status">
                Available for freelance work and collaboration.
            </p>

            <div class="specs">
                <div class="spec-item">
                    <span class="label">Architecture:</span>
                    <span class="value">Fullstack</span>
                </div>
                <div class="spec-item">
                    <span class="label">Language:</span>
                    <span class="value">English (C1), Spanish (Native)</span>
                </div>
                <div class="spec-item">
                    <span class="label">Location:</span>
                    <span class="value">Peru</span>
                </div>
            </div>
        </div>
        <div class="about-visual">
            <div class="cyber-circle">
                <Image
                    src={profileImg}
                    alt="Hugo Márquez"
                    class="profile-img"
                    loading="lazy"
                    width={250}
                    height={250}
                />
            </div>
        </div>
    </div>
</section>

<style>
    .about-section {
        min-height: calc(100vh - var(--header-h));
        display: flex;
        align-items: center;
        padding: 6rem 0;
    }

    .about-section > .container {
        width: 100%;
    }

    .about-content {
        display: flex;
        align-items: center;
        gap: 4rem;
    }

    .about-text {
        flex: 1;
    }

    .section-title {
        color: #fff;
        margin-bottom: 2rem;
        font-size: 2.5rem;
    }


    @media (max-width: 768px) {
        .section-title {
            font-size: 1.8rem;
        }
    }

    p {
        color: var(--color-text-muted);
        line-height: 1.8;
        margin-bottom: 1.5rem;
        font-size: 1.1rem;
        text-wrap: pretty;
    }

    .highlight {
        color: var(--color-text);
        font-weight: 500;
        border-bottom: 2px solid rgba(116, 217, 78, 0.5);
    }

    .freelance-status {
        font-family: var(--font-hand);
        font-size: 1.7rem;
        color: var(--color-primary);
        transform: rotate(-1.5deg);
        display: inline-block;
    }

    .specs {
        margin-top: 2rem;
        background: var(--color-bg-raised);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.5rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .spec-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.95rem;
    }

    .spec-item .label {
        color: var(--color-text-dim);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.8rem;
        align-self: center;
    }

    .spec-item .value {
        color: var(--color-text);
        text-align: right;
    }

    .about-visual {
        flex: 1;
        display: flex;
        justify-content: center;
    }

    .cyber-circle {
        width: 250px;
        height: 250px;
        border: 1px solid var(--color-border);
        border-radius: 50%;
        position: relative;
        padding: 10px;
        background: var(--color-bg-raised);
    }

    .profile-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        opacity: 0.9;
        filter: grayscale(100%);
        transition:
            filter 0.5s ease,
            opacity 0.5s ease;
    }

    .cyber-circle:hover .profile-img {
        filter: grayscale(0%);
        opacity: 1;
    }

    @media (max-width: 768px) {
        .about-content {
            flex-direction: column-reverse;
            gap: 2.5rem;
        }

        .section-path,
        .section-title {
            text-align: center;
        }

        .cyber-circle {
            width: 170px;
            height: 170px;
        }

        .freelance-status {
            transform: none;
            font-size: 1.5rem;
        }
    }
</style>
