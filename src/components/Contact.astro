---
import { Icon } from "astro-icon/components";
---

<section id="contact" class="contact-section">
    <div class="container contact-inner">
        <p class="section-path">say hi</p>
        <h2 class="section-title">Contact</h2>
        <p class="contact-copy">
            Have a project in mind, a role to fill, or just want to talk dev?
            My inbox is open.
        </p>

        <a href="mailto:hmarquezd1@gmail.com" class="mail-btn">
            <Icon name="mdi:email-outline" class="mail-icon" />
            hmarquezd1@gmail.com
        </a>

        <div class="contact-socials">
            <a
                href="https://github.com/HugoX2003"
                target="_blank"
                class="social-link"
            >
                <Icon name="mdi:github" class="social-icon" /> GitHub
            </a>
            <a
                href="https://www.linkedin.com/in/hugomarquezdiestra/"
                target="_blank"
                class="social-link"
            >
                <Icon name="mdi:linkedin" class="social-icon" /> LinkedIn
            </a>
        </div>
    </div>
</section>

<style>
    .contact-section {
        min-height: calc(100vh - var(--header-h));
        display: flex;
        align-items: center;
        padding: 6rem 0;
    }

    .contact-inner {
        width: 100%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .section-title {
        color: #fff;
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .contact-copy {
        color: var(--color-text-muted);
        font-size: 1.1rem;
        max-width: 460px;
        line-height: 1.7;
        margin: 0 0 2.5rem;
        text-wrap: pretty;
    }

    .mail-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-heading);
        font-weight: 500;
        font-size: 1.15rem;
        color: #0d1522;
        background: var(--color-primary);
        border: 1px solid var(--color-primary);
        border-radius: var(--radius);
        padding: 16px 32px;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .mail-btn:hover {
        background: #8ae867;
        color: #0d1522;
        transform: translateY(-2px);
    }

    .mail-icon {
        width: 22px;
        height: 22px;
    }

    .contact-socials {
        display: flex;
        gap: 2rem;
        margin-top: 2.5rem;
    }

    .social-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-text-muted);
        font-size: 0.95rem;
    }

    .social-link:hover {
        color: var(--color-text);
    }

    .social-icon {
        width: 20px;
        height: 20px;
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 1.9rem;
        }

        .mail-btn {
            font-size: 0.95rem;
            padding: 14px 20px;
        }
    }
</style>
