---

<section class="hero">
    <div class="container hero-content">
        <h1 class="hero-title">Hugo Márquez</h1>
        <p class="hero-subtitle">Systems Engineer · Fullstack · Cloud &amp; DevOps</p>

        <div class="cta-container">
            <a href="#projects" class="btn primary">View projects</a>
            <a
                href="https://github.com/HugoX2003"
                target="_blank"
                class="btn"
            >
                GitHub
            </a>
            <a
                href="https://drive.google.com/file/d/1-5zokp42yqHBhsl7xclR1-Kg6YBjdT0J/view?usp=sharing"
                target="_blank"
                class="btn"
            >
                Download CV
            </a>
        </div>

        <div class="status-panel">
            <div class="status-line">
                <span class="label">Location</span>
                <span class="value">Trujillo, Peru</span>
            </div>
            <div class="status-line">
                <span class="label">Role</span>
                <span class="value">Backend Developer</span>
            </div>
            <div class="status-line">
                <span class="label">Focus</span>
                <span class="value">Cloud &amp; DevOps</span>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: calc(100vh - var(--header-h));
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 4rem 0 12rem;
    }

    .hero-content {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    .hero-title {
        font-size: 5rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.5rem;
        line-height: 1.05;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        margin: 0 0 0.75rem;
    }

    .cta-container {
        display: flex;
        gap: 1rem;
        margin: 2rem 0 4rem;
    }

    .btn {
        padding: 14px 28px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        color: var(--color-text);
        font-family: var(--font-heading);
        font-weight: 500;
        font-size: 1rem;
        background: rgba(13, 21, 34, 0.4);
        backdrop-filter: blur(4px);
        transition:
            background 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .btn:hover {
        border-color: var(--color-text-muted);
        color: #fff;
        transform: translateY(-2px);
    }

    .btn.primary {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: #0d1522;
    }

    .btn.primary:hover {
        background: #8ae867;
        border-color: #8ae867;
        color: #0d1522;
    }

    .status-panel {
        display: flex;
        gap: 3rem;
        padding: 1rem 2rem;
        border: 1px solid rgba(36, 53, 74, 0.8);
        border-radius: var(--radius);
        background: rgba(13, 21, 34, 0.45);
        backdrop-filter: blur(4px);
    }

    .status-line {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        text-align: left;
    }

    .label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--color-text-dim);
    }

    .value {
        font-family: var(--font-hand);
        font-size: 1.6rem;
        color: var(--color-primary);
        line-height: 1.1;
    }

    @media (max-width: 768px) {
        .hero {
            padding-bottom: 8rem;
        }

        .hero-title {
            font-size: 2.75rem;
        }

        .cta-container {
            flex-direction: column;
            width: 100%;
        }

        .btn {
            width: 100%;
            text-align: center;
        }

        .status-panel {
            flex-direction: column;
            gap: 1rem;
            width: 100%;
        }
    }
</style>
