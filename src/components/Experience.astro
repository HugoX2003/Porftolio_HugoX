---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import constanciaAccodec from "../assets/constancia_accodec.pdf";
import saurodevImg from "../assets/saurodev_dailyscrum.webp";
import mtdLpImg from "../assets/mtd_lp.webp";

const experiences = [
    {
        id: "aquaware",
        company: "Aquaware LLC",
        role: "DevOps Engineer",
        period: "Mar 2026 – Present",
        current: true,
        description:
            "Designing and implementing cloud architectures on AWS with Terraform. Remote, contract role.",
        details: [],
        image: null,
    },
    {
        id: "corall",
        company: "CorAll",
        role: "Backend Developer",
        period: "Feb 2026 – Present",
        current: true,
        description:
            "Development and integration of backend components for CorAll's platforms: REST APIs, business logic, database management and security mechanisms, with Node.js and TypeScript.",
        details: [],
        image: null,
    },
    {
        id: "accodec",
        company: "ACCODEC",
        role: "Pre-professional Intern",
        period: "April 2025 – July 2025",
        current: false,
        description:
            "Educational platform administration and technical support.",
        caption: "Internship Certificate - 360 hours of systems area support.",
        details: [
            "Administered and maintained educational platforms (Moodle, WordPress, WooCommerce).",
            "Configured plugins and managed over 200 user profiles.",
            "Provided technical support and diagnosed incidents.",
            "Collaborated on improvements to virtual learning environments.",
        ],
        image: constanciaAccodec,
    },
    {
        id: "saurodev",
        company: "SauroDev",
        role: "Frontend Developer",
        period: "May 2024 – July 2025",
        current: false,
        description:
            "Responsive web interface development with Angular and React, integrating REST APIs.",
        caption: "Daily Scrum Meeting - Active participation in agile methodology.",
        details: [
            "Developed responsive web interfaces with Angular and React.",
            "Integrated REST API consumption and backend services in Java/Spring Boot.",
            "Implemented reusable components and business logic on the frontend.",
            "Applied architectural best practices and clean code.",
            "Worked under Scrum methodology in iterative development cycles.",
        ],
        image: saurodevImg,
    },
    {
        id: "mtd",
        company: "Make The Difference",
        role: "Frontend Developer",
        period: "Jan 2024 – Mar 2025",
        current: false,
        description:
            "Design and development of Landing Page with React and Figma.",
        caption: "Landing Page & Banner - Designed and developed from scratch.",
        details: [
            "Designed and developed a landing page with React, implementing Figma prototypes.",
            "Implemented key sections (navigation bar, banner, timeline).",
            "Optimized HTML5 and CSS3 for cross-browser compatibility and performance.",
            "Collaborated with the UX/UI team to align prototypes with technical implementation.",
        ],
        image: mtdLpImg,
    },
];
---

<section id="experience" class="experience-section">
    <div class="container">
        <p class="section-path">where i've worked</p>
        <h2 class="section-title">Experience</h2>

        <div class="timeline">
            {
                experiences.map((exp) => (
                    <div class="timeline-item">
                        <div class="timeline-content">
                            <div class="header">
                                <h3 class="company">{exp.company}</h3>
                                <span class={`period ${exp.current ? "now" : ""}`}>
                                    {exp.period}
                                </span>
                            </div>
                            <h4 class="role">{exp.role}</h4>
                            <p class="description">{exp.description}</p>

                            {exp.image && (
                                <button class="view-more-btn" data-id={exp.id}>
                                    <Icon name="mdi:eye" class="btn-icon" />
                                    <span>View certificate / details</span>
                                </button>
                            )}
                        </div>

                        {exp.image && (
                            <dialog id={`modal-${exp.id}`} class="retro-modal">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h3>
                                            {exp.company} - <span>{exp.role}</span>
                                        </h3>
                                        <button
                                            class="close-btn"
                                            data-close={exp.id}
                                            aria-label="Close"
                                        >
                                            <Icon name="mdi:close" />
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="details-list">
                                            <h4>Responsibilities &amp; achievements</h4>
                                            <ul>
                                                {exp.details.map((detail) => (
                                                    <li>{detail}</li>
                                                ))}
                                            </ul>
                                        </div>
                                        <div class="proof-visual">
                                            <h4 class="proof-title">
                                                <Icon
                                                    name="mdi:file-document-outline"
                                                    class="doc-icon-sm"
                                                />
                                                <span>Certificate / proof</span>
                                            </h4>

                                            <div class="media-container">
                                                {typeof exp.image === "string" ? (
                                                    <div class="pdf-container">
                                                        <embed
                                                            src={`${exp.image}#toolbar=0`}
                                                            type="application/pdf"
                                                            width="100%"
                                                            height="400px"
                                                        />
                                                        <div class="caption-box">
                                                            <Icon
                                                                name="mdi:information-outline"
                                                                class="info-icon"
                                                            />
                                                            <span>{exp.caption}</span>
                                                        </div>
                                                        <a
                                                            href={exp.image}
                                                            target="_blank"
                                                            class="download-link"
                                                        >
                                                            Open PDF in new tab
                                                        </a>
                                                    </div>
                                                ) : (
                                                    <div class="img-wrapper">
                                                        <Image
                                                            src={exp.image}
                                                            alt={`${exp.company} proof`}
                                                            width={800}
                                                            height={600}
                                                            class="proof-img"
                                                            loading="lazy"
                                                        />
                                                        <div class="img-caption">
                                                            <Icon
                                                                name="mdi:information-outline"
                                                                class="info-icon"
                                                            />
                                                            <span>{exp.caption}</span>
                                                        </div>
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </dialog>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { setupModals } from "../scripts/utils";

    document.addEventListener("astro:page-load", () => {
        setupModals(".view-more-btn", ".close-btn", "dialog.retro-modal");
    });

    document.addEventListener("DOMContentLoaded", () => {
        setupModals(".view-more-btn", ".close-btn", "dialog.retro-modal");
    });
</script>

<style>
    .experience-section {
        min-height: calc(100vh - var(--header-h));
        display: flex;
        align-items: center;
        padding: 6rem 0;
        position: relative;
    }

    .experience-section > .container {
        width: 100%;
    }

    .section-path {
        text-align: center;
    }

    .section-title {
        color: #fff;
        text-align: center;
        margin-bottom: 4rem;
        font-size: 2.5rem;
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 1.9rem;
            margin-bottom: 3rem;
        }
    }

    .timeline {
        position: relative;
        max-width: 720px;
        margin: 0 auto;
        padding-left: 2rem;
        border-left: 1px solid var(--color-border);
    }

    @media (max-width: 600px) {
        .timeline {
            padding-left: 1.1rem;
        }

        .timeline-item::before {
            left: calc(-1.1rem - 5px);
        }

        .timeline-content {
            padding: 1.1rem;
        }
    }

    .timeline-item {
        margin-bottom: 2.5rem;
        position: relative;
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    /* ridge marker on the rule */
    .timeline-item::before {
        content: "";
        position: absolute;
        left: calc(-2rem - 5px);
        top: 26px;
        width: 9px;
        height: 9px;
        background: var(--color-bg);
        border: 2px solid var(--color-text-dim);
        border-radius: 50%;
        transition: border-color 0.25s ease, background 0.25s ease;
    }

    .timeline-item:hover::before {
        border-color: var(--color-primary);
        background: var(--color-primary);
    }

    .timeline-content {
        background: var(--color-bg-raised);
        border: 1px solid var(--color-border);
        padding: 1.5rem;
        border-radius: var(--radius);
        transition: border-color 0.25s ease, transform 0.25s ease;
    }

    .timeline-content:hover {
        border-color: var(--color-text-dim);
        transform: translateX(4px);
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .company {
        color: #fff;
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
    }

    .period {
        font-size: 0.8rem;
        color: var(--color-text-muted);
        border: 1px solid var(--color-border);
        padding: 0.15rem 0.6rem;
        border-radius: 20px;
    }

    .period.now {
        font-family: var(--font-hand);
        font-size: 1.15rem;
        color: var(--color-primary);
        border-color: rgba(116, 217, 78, 0.4);
    }

    .role {
        color: var(--color-secondary);
        font-size: 1rem;
        font-weight: 500;
        margin: 0 0 0.5rem 0;
    }

    .description {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1rem;
        text-wrap: pretty;
    }

    .timeline-content .description:last-child {
        margin-bottom: 0;
    }

    .view-more-btn {
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        color: var(--color-secondary);
        padding: 0.5rem 1rem;
        font-family: var(--font-body);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: border-color 0.2s ease, color 0.2s ease;
        font-size: 0.85rem;
    }

    .view-more-btn:hover {
        border-color: var(--color-secondary);
        color: var(--color-accent);
    }

    /* Modal */
    .retro-modal {
        background: var(--color-bg-raised);
        border: 1px solid var(--color-border);
        color: var(--color-text);
        max-width: 600px;
        width: 90%;
        max-height: 88vh;
        overflow-y: auto;
        padding: 0;
        border-radius: var(--radius);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    }

    .retro-modal::backdrop {
        background: rgba(6, 10, 17, 0.8);
        backdrop-filter: blur(2px);
    }

    .modal-content {
        padding: 2rem;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .modal-header h3 {
        color: #fff;
        margin: 0;
        font-size: 1.2rem;
    }

    .modal-header h3 span {
        color: var(--color-secondary);
        font-weight: 500;
    }

    .close-btn {
        background: none;
        border: none;
        color: var(--color-text-muted);
        font-size: 1.5rem;
        cursor: pointer;
    }

    .close-btn:hover {
        color: #fff;
    }

    .details-list h4,
    .proof-title {
        color: var(--color-text);
        font-size: 1rem;
    }

    .details-list ul {
        list-style: none;
        padding: 0;
    }

    .details-list li {
        margin-bottom: 0.5rem;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        padding-left: 1.1rem;
        position: relative;
    }

    .details-list li::before {
        content: "—";
        position: absolute;
        left: 0;
        color: var(--color-primary);
    }

    .proof-visual {
        margin-top: 2rem;
        border: 1px dashed var(--color-border);
        border-radius: var(--radius);
        padding: 1rem;
        background: rgba(13, 21, 34, 0.5);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .proof-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 0.5rem;
    }

    .doc-icon-sm {
        font-size: 1.2rem;
    }

    .media-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .img-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 4px;
        display: flex;
        justify-content: center;
        background: var(--color-bg);
        width: 100%;
    }

    .proof-img {
        max-width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
    }

    .img-wrapper:hover .proof-img {
        transform: scale(1.02);
    }

    .img-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        background: rgba(13, 21, 34, 0.92);
        color: var(--color-text);
        padding: 0.75rem;
        transform: translateY(100%);
        transition: transform 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        border-top: 1px solid var(--color-border);
    }

    .img-wrapper:hover .img-caption {
        transform: translateY(0);
    }

    .caption-box {
        width: 100%;
        background: rgba(13, 21, 34, 0.8);
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-primary);
        border-radius: 4px;
        padding: 0.75rem;
        margin-top: 0.5rem;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-icon {
        font-size: 1.2rem;
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .pdf-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .download-link {
        font-size: 0.85rem;
        text-align: center;
        padding: 0.5rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        color: var(--color-secondary);
        margin-top: 0.5rem;
    }

    .download-link:hover {
        border-color: var(--color-secondary);
        color: var(--color-accent);
    }
</style>
